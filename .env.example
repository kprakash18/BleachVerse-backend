NODE_ENV=development
PORT=3000
API_HOST_PORT=3001

DATABASE_URL=
DIRECT_URL=

CORS_ALLOWED_ORIGINS=

TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

RATE_LIMIT_EXPENSIVE_API_MS=
RATE_LIMIT_EXPENSIVE_MAX=

# Neo4j Graph Database (Local Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Set true only when the API should fail startup if graph search is unavailable.
REQUIRE_NEO4J=false

# Neo4j Graph Database (Production / Aura Cloud)
# NEO4J_URI=neo4j+s://<instance_id>.databases.neo4j.io
# NEO4J_USERNAME=<username>
# NEO4J_PASSWORD=<password>
# NEO4J_DATABASE=neo4j

# AI Semantic Search & Embedding Providers
# Options: 'mock' (default / $0 offline local), 'gemini' (Google Free Cloud Tier)
EMBEDDING_PROVIDER=mock
# GEMINI_API_KEY=AIzaSy...
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
